NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/maskchat
COOKIE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
ALLOW_DEV_AUTH=true
ADMIN_EMAIL=moderator@example.edu

# Institution verification policy (configure approved domains explicitly for deployment)
INSTITUTION_DOMAINS=galgotiacollege.edu
# Example pattern for prefix.YY + 3-letter institution code + degree + program + numeric student code
# Override this for institutions with a different identifier structure.
INSTITUTION_EMAIL_PATTERN=^[^.]+\.(?<cohort>\d{2})(?<institutionCode>[a-z]{3})(?<degreeCode>[a-z])(?<programCode>[a-z]{2,5})(?<studentCode>\d+)@(?<domain>[^@]+)$
REQUIRE_INSTITUTION_DOMAIN=false
PRIVATE_UPLOAD_DIR=./private-uploads

# Optional server-side OpenAI-compatible AI provider; never use VITE_ prefixes for secrets
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=20

# Junior mentor recommendation policy; adjust only through reviewed configuration
JUNIOR_MENTOR_MIN_RATING=4.5
JUNIOR_MENTOR_MIN_SESSIONS=5

OBSERVABILITY_WINDOW_MS=60000
OBSERVABILITY_MAX_SAMPLES=10000
ERROR_RATE_ALERT=0.10
HTTP_P95_ALERT_MS=1500
EVENT_LOOP_P99_ALERT_MS=250
